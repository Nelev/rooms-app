# Copy to .env. `make dev` and docker compose read it.

# Postgres (pgvector): the LangGraph checkpointer, the store and the projects registry. docker compose overrides it for its backend.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rooms

# Models, through OpenRouter. Not needed for `make dev-stub` (fake model).
OPENROUTER_API_KEY=

# Tracing (optional).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Object storage for photos, overlays, renders and GLBs (S3-compatible).
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
