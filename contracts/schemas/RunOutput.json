{
  "title": "RunOutput",
  "$defs": {
    "CameraPose": {
      "additionalProperties": false,
      "description": "A camera in the three.js convention (y-up: room (x, y, z) is three.js (x, z, -y)), e.g. the one that took a photo.",
      "examples": [
        {
          "fov": 55.0,
          "image_height": 3024,
          "image_width": 4032,
          "photo_key": "uploads/3f2a/photo-1.jpg",
          "position": [
            0.4,
            1.5,
            -0.3
          ],
          "quaternion": [
            0.0,
            0.9239,
            0.0,
            0.3827
          ],
          "reprojection_error": 3.2
        }
      ],
      "properties": {
        "photo_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Photo Key"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "quaternion": {
          "description": "x, y, z, w",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quaternion",
          "type": "array"
        },
        "fov": {
          "description": "Vertical field of view in degrees",
          "exclusiveMaximum": 180,
          "exclusiveMinimum": 0,
          "title": "Fov",
          "type": "number"
        },
        "image_width": {
          "exclusiveMinimum": 0,
          "title": "Image Width",
          "type": "integer"
        },
        "image_height": {
          "exclusiveMinimum": 0,
          "title": "Image Height",
          "type": "integer"
        },
        "reprojection_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pixels",
          "title": "Reprojection Error"
        }
      },
      "required": [
        "position",
        "quaternion",
        "fov",
        "image_width",
        "image_height"
      ],
      "title": "CameraPose",
      "type": "object"
    },
    "CatalogItem": {
      "additionalProperties": false,
      "examples": [
        {
          "category": "nightstand",
          "color": "white",
          "description": "Solid pine nightstand with one drawer",
          "front": "+z",
          "glb_url": "https://example.com/models/hemnes-nightstand.glb",
          "id": "ikea-hemnes-nightstand",
          "license": "CC-BY-4.0",
          "name": "HEMNES nightstand",
          "price": 89.0,
          "size": {
            "depth": 0.35,
            "height": 0.7,
            "width": 0.46
          },
          "style_tags": [
            "scandinavian",
            "traditional"
          ]
        }
      ],
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/Size"
        },
        "price": {
          "description": "EUR",
          "minimum": 0,
          "title": "Price",
          "type": "number"
        },
        "style_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Style Tags",
          "type": "array"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "front": {
          "default": "+z",
          "description": "The GLB's local axis the item's front faces (glTF is y-up)",
          "enum": [
            "+x",
            "-x",
            "+z",
            "-z"
          ],
          "title": "Front",
          "type": "string"
        },
        "glb_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Glb Url"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Product page",
          "title": "Url"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "size",
        "price"
      ],
      "title": "CatalogItem",
      "type": "object"
    },
    "Critique": {
      "additionalProperties": false,
      "examples": [
        {
          "actions": [
            {
              "instruction": "Put the bed against wall D",
              "node_id": "bed",
              "target": "architect"
            }
          ],
          "round": 1,
          "rules": [
            {
              "passed": true,
              "rule": "desk_near_light"
            },
            {
              "message": "The bed faces the door",
              "passed": false,
              "rule": "bed_not_facing_door"
            }
          ],
          "summary": "One rule fails: the bed faces the door"
        }
      ],
      "properties": {
        "round": {
          "minimum": 1,
          "title": "Round",
          "type": "integer"
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuleResult"
          },
          "title": "Rules",
          "type": "array"
        },
        "actions": {
          "default": [],
          "description": "Empty when the layout is accepted",
          "items": {
            "$ref": "#/$defs/CritiqueAction"
          },
          "title": "Actions",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "round",
        "summary"
      ],
      "title": "Critique",
      "type": "object"
    },
    "CritiqueAction": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": [
            "architect",
            "sourcer"
          ],
          "title": "Target",
          "type": "string"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "instruction": {
          "title": "Instruction",
          "type": "string"
        }
      },
      "required": [
        "target",
        "instruction"
      ],
      "title": "CritiqueAction",
      "type": "object"
    },
    "Dimensions": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "description": "Length of walls A and C (x)",
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "length": {
          "description": "Length of walls B and D (y)",
          "minimum": 0,
          "title": "Length",
          "type": "number"
        },
        "height": {
          "description": "Ceiling height",
          "minimum": 0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "width",
        "length",
        "height"
      ],
      "title": "Dimensions",
      "type": "object"
    },
    "Feature": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "window",
            "door",
            "radiator",
            "outlet",
            "built_in",
            "column",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "wall": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ],
          "title": "Wall",
          "type": "string"
        },
        "offset": {
          "description": "Feature center as a fraction of the wall length from the wall's start corner",
          "maximum": 1,
          "minimum": 0,
          "title": "Offset",
          "type": "number"
        },
        "width": {
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "minimum": 0,
          "title": "Height",
          "type": "number"
        },
        "sill_height": {
          "default": 0,
          "description": "Height of the feature's bottom edge above the floor; 0 for doors",
          "minimum": 0,
          "title": "Sill Height",
          "type": "number"
        },
        "swing": {
          "anyOf": [
            {
              "enum": [
                "in",
                "out"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Doors only: whether the door opens into the room or out of it; a door without it opens in",
          "title": "Swing"
        },
        "hinge": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Doors only: the hinge side, seen from inside the room facing the door; a door without it is hinged left",
          "title": "Hinge"
        },
        "confidence": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "id",
        "type",
        "wall",
        "offset",
        "width",
        "height"
      ],
      "title": "Feature",
      "type": "object"
    },
    "KeptItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "description": "Counterclockwise about z, 0 = front faces +y",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Rotation",
          "type": "number"
        },
        "size": {
          "$ref": "#/$defs/Size"
        }
      },
      "required": [
        "id",
        "name",
        "x",
        "y",
        "size"
      ],
      "title": "KeptItem",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "description": "Where each SceneGraph node ended up, in room coordinates.",
      "examples": [
        {
          "placements": [
            {
              "node_id": "bed",
              "rotation": 90,
              "size": {
                "depth": 2.1,
                "height": 1.0,
                "width": 1.6
              },
              "x": 2.15,
              "y": 2.0
            },
            {
              "item_id": "ikea-micke-desk",
              "node_id": "desk",
              "rotation": 180,
              "size": {
                "depth": 0.5,
                "height": 0.75,
                "width": 1.05
              },
              "x": 1.6,
              "y": 3.7
            }
          ]
        }
      ],
      "properties": {
        "placements": {
          "items": {
            "$ref": "#/$defs/Placement"
          },
          "title": "Placements",
          "type": "array"
        }
      },
      "required": [
        "placements"
      ],
      "title": "Layout",
      "type": "object"
    },
    "LayoutDiff": {
      "additionalProperties": false,
      "description": "What a chat edit changed, by node id, so the views can highlight it.",
      "examples": [
        {
          "added": [],
          "changed": [
            "desk"
          ],
          "removed": [
            "nightstand"
          ]
        }
      ],
      "properties": {
        "added": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Added",
          "type": "array"
        },
        "removed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Removed",
          "type": "array"
        },
        "changed": {
          "default": [],
          "description": "Moved, rotated or swapped",
          "items": {
            "type": "string"
          },
          "title": "Changed",
          "type": "array"
        }
      },
      "title": "LayoutDiff",
      "type": "object"
    },
    "Light": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "area",
            "directional"
          ],
          "title": "Kind",
          "type": "string"
        },
        "window_id": {
          "description": "The RoomSpec window feature the light comes through",
          "title": "Window Id",
          "type": "string"
        },
        "intensity": {
          "minimum": 0,
          "title": "Intensity",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "window_id",
        "intensity"
      ],
      "title": "Light",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0,
          "minimum": 0,
          "title": "Z",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "description": "Counterclockwise about z, 0 = front faces +y",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Rotation",
          "type": "number"
        },
        "size": {
          "$ref": "#/$defs/Size"
        }
      },
      "required": [
        "node_id",
        "x",
        "y",
        "size"
      ],
      "title": "Placement",
      "type": "object"
    },
    "RoomSpec": {
      "additionalProperties": false,
