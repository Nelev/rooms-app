          "title": "Walls",
          "type": "array"
        },
        "floor_material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Material"
        },
        "features": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "title": "Features",
          "type": "array"
        },
        "kept_furniture": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KeptItem"
          },
          "title": "Kept Furniture",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "dimensions"
      ],
      "title": "RoomSpec",
      "type": "object"
    },
    "RuleResult": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "message": {
          "default": "",
